{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "survival:monster_spawn_emitter",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "5 + (5 * math.min(1, v.size.x + v.size.y + v.size.z))"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"half_dimensions": ["(v.size.x * 2) + 0.25", "(v.size.y * 2)", "(v.size.z) + 0.25"],
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.6, 1)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.1 + v.particle_random_1 * 0.1) - (0.1 * v.particle_age)", "(0.1 + v.particle_random_1 * 0.1) - (0.1 * v.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [16, 24],
					"uv_size": [8, 8]
				}
			}
		}
	}
}