{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "v3:plank_golem",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/plank_golem"
			},
			"geometry": {
				"default": "geometry.plank_golem"
			},
			"animations": {
				"walk": "animation.plank_golem.walk",
				"shoot": "animation.plank_golem.shoot",
				"look_at_target": "animation.plank_golem.look_at_target",
				"shoot_controller": "controller.animation.plank_golem.shoot"
			},
			"scripts": {
				"initialize": [
					"v.show_arrows = false;"
				],
				"pre_animation": [
					"v.show_arrows = q.property('v3:has_arrows');"
				],
				"animate": [
					{
						"walk": "math.min(1.0, q.modified_move_speed * 10)"
					},
					"look_at_target",
					"shoot_controller"
				],
				"should_update_bones_and_effects_offscreen": true
			},
			"render_controllers": [
				"controller.render.plank_golem"
			],
			"sound_effects": {
				"shoot": "mob.plank_golem.shoot"
			},
			"particle_effects": {
				"dust": "v3:wide_dust_plume"
			},
			"spawn_egg": {
				"texture": "plank_golem_spawn_egg"
			}
		}
	}
}